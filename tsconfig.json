{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": { "@web/*": ["./apps/web/*"] }
  },
  "include": ["agent/**/*.ts", "lib/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "vercel.ts"],
  "exclude": ["node_modules", ".local", ".eve", ".output", ".vercel"]
}
