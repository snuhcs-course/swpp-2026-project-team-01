OLLAMA_API_URL=https://ollama.com/api/chat
OLLAMA_API_KEY_1=
OLLAMA_API_KEY_2=
OLLAMA_API_KEY_3=
OLLAMA_MODEL=gemma4:31b
# Local: `supabase status` at the repo root prints this. Remote: the Supabase transaction pooler URL (port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# demo (default): seeded accounts, user switching, example calendars. Google sign-in is disabled.
# real: Google sign-in + Google Calendar (read-only). Needs its own database; a demo database is refused.
APP_MODE=demo
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI in the Google Cloud console and the address you open the app on.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# 32 bytes (hex 64 chars or base64): openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
IMPACT_SIGNING_KEY=
