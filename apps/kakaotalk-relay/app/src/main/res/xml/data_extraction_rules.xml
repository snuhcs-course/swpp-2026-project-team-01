<?xml version="1.0" encoding="utf-8"?>
<!-- Secrets and pending events never leave the phone in a backup or transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
