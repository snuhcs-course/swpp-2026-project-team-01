{
  "name": "find-me-a-time",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.12.1",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "npm run build:eve && npm run build:web",
    "build:eve": "eve build",
    "build:web": "next build --turbopack apps/web",
    "db:generate": "drizzle-kit generate --config apps/web/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config apps/web/drizzle.config.ts",
    "db:push": "drizzle-kit push --config apps/web/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config apps/web/drizzle.config.ts",
    "dev": "next dev apps/web",
    "dev:eve": "eve dev",
    "dev:all": "vercel dev --local",
    "dev:web": "next dev apps/web",
    "start:eve": "eve start",
    "typecheck": "next typegen apps/web && tsgo --noEmit -p apps/web/tsconfig.json",
    "check:docs": "node scripts/check-documentation.mjs",
    "check": "npm run check:docs && openspec validate --all --strict"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@shikijs/core": "4.3.1",
    "@shikijs/engine-javascript": "4.3.1",
    "@shikijs/engine-oniguruma": "4.3.1",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@tailwindcss/postcss": "4.3.3",
    "@upstash/redis": "1.38.2",
    "@vercel/analytics": "2.0.1",
    "@vercel/connect": "2.5.2",
    "@vercel/speed-insights": "2.0.0",
    "ai": "7.0.143",
    "better-auth": "1.7.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.2",
    "eve": "0.80.1",
    "jose": "6.2.12",
    "lucide-react": "1.33.0",
    "next": "16.3.4",
    "postgres": "3.4.9",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "4.3.1",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "use-stick-to-bottom": "1.1.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "drizzle-kit": "0.31.10",
    "microsandbox": "0.5.10",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
