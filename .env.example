# Copy to .env and fill values locally. This template contains no credentials.
# Paste your OpenAI API key after the equals sign.
OPENAI_API_KEY=

# Supabase project configuration.
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Operator-only token for scripts/configure-email-smtp.mjs; never deploy to runtime.
SUPABASE_ACCESS_TOKEN=

# Cloudflare Email Service: verified sending domain and account-scoped Email Sending token.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_EMAIL_FROM=no-reply@findmeatime.com

# Google Cloud: pass the intended project explicitly to gcloud.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=

# AgentMail conversations and legacy deliveries: keep the pod-scoped runtime key.
# Admin CLI auth stays in the keychain.
AGENTMAIL_API_KEY=
AGENTMAIL_POD_ID=
AGENTMAIL_INBOX_ID=
# Populated after a deployed webhook receiver is registered.
AGENTMAIL_WEBHOOK_SECRET=

# Photon: CLI login is separate from these application credentials.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# Application configuration. TOKEN_ENCRYPTION_KEY is a base64-encoded 32-byte key;
# persist it separately from provider token rows and do not rotate it implicitly.
APP_ORIGIN=http://localhost:5173
TOKEN_ENCRYPTION_KEY=
WORKER_SECRET=
OPENAI_MODEL=gpt-4o-mini-2024-07-18
# User-requested contact verification/recovery; separate from booking notifications.
TRANSACTIONAL_EMAIL_ENABLED=false
EXTERNAL_SENDS_ENABLED=false

# Only these public values are exposed by the web build.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
