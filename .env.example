# Copy to .env and fill values locally. This template contains no credentials.
# `npm run dev` (web and agent) reads the root env files; the process environment
# wins, then .env.development.local, .env.local, .env.development and .env. Keep
# machine-specific overrides, such as the local stack's SUPABASE_*, DATABASE_URL
# and EVE_INTERNAL_SIGNING_KEY, in .env.local; it refuses the shared and release
# projects.
# Variables are introduced with the changes that use them; keep this file in step
# with documentations/technical_specification/03_provider_setup.md.

# Model provider: direct OpenAI, read by eve's openai() helper. The model ID
# (gpt-5.6-terra) is pinned in agent/agent.ts, not in the environment.
OPENAI_API_KEY=

# Supabase project configuration. For the local stack, SUPABASE_URL is
# http://127.0.0.1:54321 and the keys come from `supabase status`.
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Operator-only CLI token; never deploy to runtime.
SUPABASE_ACCESS_TOKEN=
# Server-only Postgres URL for domain code, as the `postgres` owner of the private
# `app` schema. Hosted: the Supavisor transaction pooler (port 6543) from the
# project's Connect panel; postgres.js runs with prepare: false. Local stack:
# postgresql://postgres:postgres@127.0.0.1:54322/postgres. Never expose it to a browser.
DATABASE_URL=
# Auth URLs substituted into supabase/config.toml by `supabase start`. The redirect
# list is comma-separated. CI sets the hosted values as GitHub variables, so these
# local values never reach the shared project.
SUPABASE_AUTH_SITE_URL=http://localhost:3000
SUPABASE_AUTH_ADDITIONAL_REDIRECT_URLS=http://localhost:3000/auth/callback

# Cloudflare Email Service: verified sending domain and account-scoped Email Sending token.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_EMAIL_FROM=no-reply@findmeatime.com
# Tests and local runs only: point the send endpoint at a stand-in
# (tests/e2e/support/fake-cloudflare-server.ts, for example http://127.0.0.1:3104).
# Local runs send only toward a loopback endpoint, so leaving it empty sends
# nothing locally even with a real token. Production ignores it.
CLOUDFLARE_EMAIL_API_URL=

# Google Cloud: pass the intended project explicitly to gcloud.
GOOGLE_CLOUD_PROJECT=
# The host sign-in OAuth client. supabase/config.toml reads both for the local
# stack's Google provider; CI pushes them to the hosted project. The web service
# and the job worker also need both at runtime (set them on the Vercel project):
# they exchange a host's stored refresh token at Google's token endpoint to read
# the calendar list and events. Without them Calendar reads report unavailable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Tests and local runs only: point the token exchange and the Calendar API at a
# fake Google (tests/e2e/support/fake-google-server.ts, for example
# http://127.0.0.1:3103/token and http://127.0.0.1:3103/calendar/v3). Production
# ignores both and always talks to Google.
GOOGLE_OAUTH_TOKEN_URL=
GOOGLE_CALENDAR_API_URL=
# Optional requester OAuth client. When unset, requester Continue with Google
# (consent and requester Calendar reads, in the web service and the job worker)
# uses GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET. Requester grants are
# delete-only and never revoked at Google, so sharing the host client never
# removes a host's Calendar grant. Whichever client is used needs the redirect
# URIs {origin}/connections/google/callback for https://findmeatime.com,
# https://release.findmeatime.com and http://localhost:3000.
GOOGLE_REQUESTER_CLIENT_ID=
GOOGLE_REQUESTER_CLIENT_SECRET=
# Tests and local runs only: point the requester consent screen and Google's
# token information endpoint at a fake Google (for example
# http://127.0.0.1:3103/o/oauth2/v2/auth and http://127.0.0.1:3103/tokeninfo).
# The code exchange uses GOOGLE_OAUTH_TOKEN_URL. Production ignores both.
GOOGLE_REQUESTER_AUTH_URL=
GOOGLE_TOKEN_INFO_URL=
# The server key restricted to the Routes API, for travel legs.
GOOGLE_MAPS_API_KEY=
# Tests and local runs only: point Routes computeRoutes at a stand-in
# (tests/integration/support/fake-routes.ts). Production ignores it.
GOOGLE_ROUTES_API_URL=

# AgentMail conversations: use a pod-scoped runtime key. Admin CLI auth stays in the keychain.
AGENTMAIL_API_KEY=
AGENTMAIL_POD_ID=
AGENTMAIL_INBOX_ID=
# Populated after a webhook receiver is registered.
AGENTMAIL_WEBHOOK_SECRET=

# Photon: CLI login is separate from these application credentials.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# Application configuration. TOKEN_ENCRYPTION_KEY is a base64-encoded 32-byte key
# (`openssl rand -base64 32`) that seals Google refresh tokens with AES-256-GCM; each
# row stores the key's fingerprint, so a token sealed under another key is refused.
# Persist it separately from provider token rows and do not rotate it implicitly.
# The canonical origin of the web service. APP_ALLOWED_ORIGINS lists, comma
# separated, any other origins the same deployment serves on its own (for
# example https://release.findmeatime.com). Sign-in, the Google callback, the
# post-sign-in redirect, the cross-site Origin check and the Secure cookie flag
# use the origin a request was addressed to only when it is APP_ORIGIN or listed
# here; any other host is refused with 421, so a forged Host header steers nothing.
APP_ORIGIN=http://localhost:3000
APP_ALLOWED_ORIGINS=
TOKEN_ENCRYPTION_KEY=
# Shared secret of the internal job worker (POST /api/internal/jobs), at least 32
# characters of [A-Za-z0-9_-] (`openssl rand -base64 48 | tr -d '=+/'`). Production
# sets it in Vercel; CI writes the same value and the worker URL into Supabase Vault
# from the WORKER_SECRET and WORKER_URL GitHub secrets. Locally, `npm run jobs:dev`
# needs only DATABASE_URL and never reads Vault, so sandboxes leave Vault empty.
WORKER_SECRET=
# Signs the 60-second internal bearer the web service presents to the agent
# service when it creates an eve session or sends an accepted input; at least 32
# characters (`openssl rand -base64 48`). Both services need the same value, and
# Production and Preview must each have their own. Both services also need
# SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY and DATABASE_URL, which the agent uses
# to check the browser's Supabase session and the session index. Never send it to
# a browser.
EVE_INTERNAL_SIGNING_KEY=
# Where the web service reaches the agent service. Locally `eve dev` listens on
# http://127.0.0.1:2000; deployments leave it empty and use APP_ORIGIN, whose
# /eve/v1 routes withEve sends to the agent service.
EVE_AGENT_URL=http://127.0.0.1:2000
