# Copy to .env and fill values locally. This template contains no credentials.
# Paste your OpenAI API key after the equals sign.
OPENAI_API_KEY=

# Supabase project configuration.
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Operator-only token for scripts/configure-email-smtp.mjs; never deploy to runtime.
SUPABASE_ACCESS_TOKEN=

# Cloudflare Email Service: verified sending domain and account-scoped Email Sending token.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_EMAIL_FROM=no-reply@findmeatime.com

# Google Cloud: pass the intended project explicitly to gcloud.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=

# AgentMail conversations: use a pod-scoped runtime key.
# Admin CLI auth stays in the keychain.
AGENTMAIL_API_KEY=
AGENTMAIL_POD_ID=
AGENTMAIL_INBOX_ID=
# Internal registry generation UUID; keep unset until ownership/routing are ready.
AGENTMAIL_RECEIVER_ID=
# Populated after a deployed webhook receiver is registered.
AGENTMAIL_WEBHOOK_SECRET=

# Photon: CLI login is separate from these application credentials.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# Optional dedicated sending number. Required when more than one dedicated line exists.
# Leave empty for shared-pool routing; a saved intent never switches its line.
PHOTON_LINE=

# Application-owned Photon receiver. Register only after consumer fencing and
# linking/dispatch acceptance; the matching database registry must be enabled.
PHOTON_WEBHOOK_ID=
IMESSAGE_WEBHOOK_SECRET=

# Application configuration. TOKEN_ENCRYPTION_KEY is a base64-encoded 32-byte key;
# persist it separately from provider token rows and do not rotate it implicitly.
APP_ORIGIN=http://localhost:3000
# Optional standalone local eve origin. Only accepted when both origins are loopback.
# Leave empty on Vercel: the web gateway uses APP_ORIGIN and the composed eve service.
EVE_LOCAL_ORIGIN=
TOKEN_ENCRYPTION_KEY=
# Native direct-OpenAI model. Changes require model metadata and capability checks.
OPENAI_MODEL=gpt-6-luna

# Narrow internal dispatcher credential: 32 random bytes as 64 lowercase hex characters.
# Configure matching Supabase Vault entries only on the intended release database.
RUNTIME_DISPATCH_SECRET=

# Application-owned agent OAuth (internal primitives only; routes are not active).
# Server-only P-256 private JWK with unique kid. See provider setup before activation.
# Never reuse Supabase or Google keys or generate transient keys at runtime.
AGENT_OAUTH_SIGNING_JWK=
# Optional JSON array of up to three retiring PUBLIC verification keys; no private d.
AGENT_OAUTH_RETIRED_JWKS=[]

# Exact browser MCP client origins; native clients may omit Origin. No wildcards.
MCP_ALLOWED_ORIGINS=[]

# Invitation operator CLI and scheduled delivery code derivation.
# Dedicated canonical base64 of 32 random bytes; never reuse TOKEN_ENCRYPTION_KEY.
# Preserve through outstanding invitation lifetimes; rotation must not reissue codes.
INVITATION_CODE_KEY=

# Agent-intake browser proof derivation (pending production activation).
# Dedicated canonical base64 of 32 random bytes, separate from encryption/OAuth keys.
# Preserve across request credential lifetimes; never generate or rotate at startup.
AGENT_INTAKE_PROOF_KEY=
