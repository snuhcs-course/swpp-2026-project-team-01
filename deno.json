{
  "nodeModulesDir": "none",
  "minimumDependencyAge": 0,
  "imports": {
    "hono": "npm:hono@4.13.13",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.117.2"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "dom", "dom.iterable", "esnext"]
  },
  "tasks": {
    "check": "deno check supabase/functions/api/index.ts supabase/functions/worker/index.ts",
    "test": "deno test --allow-env --allow-read supabase/functions",
    "fmt": "deno fmt --check supabase/functions packages/contracts scripts"
  },
  "fmt": { "lineWidth": 100, "singleQuote": true },
  "lint": { "exclude": ["node_modules", "apps/web/node_modules"] }
}
